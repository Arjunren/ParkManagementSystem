FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
DATABASE_URL=mysql+pymysql://parking_user:replace-me@127.0.0.1:3306/parking_management?charset=utf8mb4
FACILITY_NAME=ParkFlow Parking Facility
SESSION_MINUTES=60
PASSWORD_MIN_LENGTH=10
RESET_TOKEN_MINUTES=30

# Use Redis in a multi-process production deployment.
RATELIMIT_STORAGE_URI=memory://

# Optional SMTP settings for password-reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
